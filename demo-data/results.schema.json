{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Campus Guardian results",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "video",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "required": [
        "generated_by"
      ],
      "properties": {
        "generated_by": {
          "enum": [
            "real-pipeline",
            "sample"
          ]
        },
        "generated_at": {
          "type": "string"
        },
        "source_video": {
          "type": "string"
        },
        "models": {
          "type": "object"
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "src",
        "duration_s"
      ],
      "properties": {
        "src": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_s": {
          "type": "number"
        },
        "fps": {
          "type": "number"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "plate_text",
          "plate_confidence",
          "face_match_name",
          "face_score",
          "db_status",
          "decision",
          "bbox"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "timestamp": {
            "type": "number",
            "description": "seconds into the video when the decision is made (best plate reading)"
          },
          "ts_start": {
            "type": "number",
            "description": "first time the plate was seen"
          },
          "ts_end": {
            "type": "number",
            "description": "last time the plate was seen"
          },
          "plate_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "plate_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "detector_confidence": {
            "type": "number"
          },
          "face_match_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "null = face verification not performed"
          },
          "face_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "db_status": {
            "enum": [
              "REGISTERED",
              "UNREGISTERED",
              "BLOCKLISTED",
              "INACTIVE",
              "PENDING",
              "LOW_CONFIDENCE",
              "NO_PLATE",
              "NOT_CHECKED"
            ]
          },
          "decision": {
            "enum": [
              "ALLOWED",
              "DENIED",
              "REVIEW"
            ]
          },
          "owner_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "bbox": {
            "type": "object",
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "description": "fractions (0-1) of frame width/height; x,y = top-left",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "w": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "h": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "track": {
            "type": "array",
            "description": "optional box positions over time so the overlay follows the car",
            "items": {
              "type": "object",
              "required": [
                "t",
                "x",
                "y",
                "w",
                "h"
              ]
            }
          }
        }
      }
    }
  }
}