# ---------------------------------------------------------------
# Environment: "development" (default) or "production".
# In production the app refuses to start with a weak/default JWT_SECRET.
# ---------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------
# Database
# SQLite (default) is fine for local dev - zero setup. On a hosted server the
# container's disk is usually wiped on every deploy, so use MySQL there:
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/campus_gate_ai
# ---------------------------------------------------------------
DATABASE_URL=sqlite:///./campus_gate_ai.db

# ---------------------------------------------------------------
# Auth - generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------
JWT_SECRET=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------
# CORS - comma separated list of frontend origins allowed to call this API.
# Must EXACTLY match the deployed frontend URL (scheme + host, no trailing /).
#   CORS_ORIGINS=https://campus-guardian.vercel.app
# ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------
# AI pipeline - keep true until you've trained both YOLO models (see
# ../ai/train_plate_yolo.py and ../ai/train_face_yolo.py), placed their
# best.pt files at the paths below, and installed requirements-ai.txt.
# ---------------------------------------------------------------
MOCK_AI=true
REQUIRE_FACE_VERIFICATION=false
MIN_PLATE_CONFIDENCE=0.55
MIN_FACE_CONFIDENCE=0.60

# OCR readings are rarely character-perfect - fall back to the closest
# registered plate if it's similar enough rather than flagging unknown.
PLATE_FUZZY_MATCHING=true
PLATE_FUZZY_THRESHOLD=0.82

# Real AI model paths/config - only read once MOCK_AI=false.
PLATE_MODEL_PATH=app/ai/weights/plate_best.pt
FACE_MODEL_PATH=app/ai/weights/face_best.pt
AI_DEVICE=cpu
PLATE_DETECTOR_CONF=0.4
FACE_DETECTOR_CONF=0.5
OCR_LANGUAGES=en

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
