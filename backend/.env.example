# =====================================================================
# backend/.env  (copy this file to .env). Same code, two modes - see DEMO_MODE.
# =====================================================================

# ---- THE SWITCH ------------------------------------------------------
# true  = hosted demo (Render): real login + database + dashboard, AI NOT run;
#         the app replays ../demo-data/results.json. Heavy libs never imported.
# false = full local project: upload ANY video, the real pipeline runs.
#         Needs:  pip install -r ../ai-service/requirements.txt
DEMO_MODE=true

APP_ENV=development            # "production" on Render (refuses a weak JWT_SECRET)

# ---- Database --------------------------------------------------------
# Local: SQLite file, zero setup.
DATABASE_URL=sqlite:///./campus_gate_ai.db
# Render: your Aiven MySQL (create a separate database for this project):
#   DATABASE_URL=mysql+pymysql://avnadmin:PASSWORD@HOST:PORT/campus_guardian
#   DB_SSL_CA=certs/aiven-ca.pem
DB_SSL_CA=

# ---- Auth ------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins, EXACT (scheme+host, no trailing slash).
# On Render add your Vercel URL, e.g. https://campus-guardian.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Google sign-in (optional) ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_AUTO_CREATE=false
GOOGLE_ADMIN_EMAILS=

# ---- Local mode only (DEMO_MODE=false) -------------------------------
AI_DEVICE=cpu                  # or 0 for a CUDA GPU
PLATE_DETECTOR_CONF=0.4
MIN_PLATE_CONFIDENCE=0.45      # below this the decision is REVIEW, not ALLOWED/DENIED
PLATE_FUZZY_MATCHING=true      # tolerate OCR slips like O/0, I/1
PLATE_FUZZY_THRESHOLD=0.82
MAX_VIDEO_MB=200
# PLATE_MODEL_PATH=../ai-service/weights/plate_best.pt   (default)

# Old per-frame /live page (local mode): keep true unless you also use it with real AI
MOCK_AI=false
REQUIRE_FACE_VERIFICATION=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
DEDUPE_WINDOW_SECONDS=45
