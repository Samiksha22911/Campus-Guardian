# frontend/.env  (local)  /  Vercel -> Project Settings -> Environment Variables.
# Vite bakes these in at BUILD time: change one -> redeploy.

# Backend URL. Local: http://localhost:8000   Hosted: your Render URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# true only on the hosted demo: shows the recruiter login hint on the sign-in page.
VITE_DEMO_MODE=false

# Optional Google sign-in
VITE_GOOGLE_CLIENT_ID=
