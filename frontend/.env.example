# Public URL of the deployed FastAPI backend (no trailing slash needed).
# Vite bakes this in at BUILD time, so set it in your host's environment
# variables (Vercel / Netlify / etc.) and redeploy after changing it.
VITE_API_URL=http://localhost:8000

# Google OAuth client ID (public - safe in the browser). Rebuild after changing.
VITE_GOOGLE_CLIENT_ID=

# Optional: video to loop on the Live page. Default is /demo.mp4 (put the file in frontend/public/).
# VITE_DEMO_VIDEO_URL=/demo.mp4
